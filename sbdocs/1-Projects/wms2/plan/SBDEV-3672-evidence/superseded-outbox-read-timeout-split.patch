--- /dev/null
+++ b/src/test/java/net/aim_ai/wms/unit/service/HttpRestServiceReadTimeoutTest.java
@@ -0,0 +1,120 @@
+package net.aim_ai.wms.unit.service;
+
+import com.sun.net.httpserver.HttpServer;
+import net.aim_ai.wms.service.HttpRestService;
+import net.aim_ai.wms.service.SyspropService;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.web.client.ResourceAccessException;
+
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.net.SocketTimeoutException;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatCode;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+
+/**
+ * SBDEV-3672 — the outbox dispatcher's OMS calls get their own read timeout, separate from the one
+ * the interactive callers use.
+ *
+ * <p>OMS {@code finishedShipping} processes a whole BOL inside the request. On ShipItEZ c1wh every
+ * payload of 37–107 KB outlived the single shared 15 s read timeout on its first attempt, and a
+ * 664 KB BOL outlived it on all six, ending {@code FAILED_TERMINAL}. Raising the shared value would
+ * freeze operator screens behind the same wait, so the dispatcher's client is configured on its own.
+ *
+ * <p>Drives a real local HTTP server rather than a mocked {@code RestClient}: a mock cannot time out,
+ * so a mock-based test would pass whatever timeout either client was built with.
+ */
+@DisplayName("SBDEV-3672 — HttpRestService read timeouts: interactive vs outbox")
+class HttpRestServiceReadTimeoutTest {
+
+    /** How long the stub OMS takes to answer. Far above the interactive timeout, far below the outbox one. */
+    private static final int OMS_ANSWER_DELAY_MS = 1_500;
+    private static final int INTERACTIVE_READ_TIMEOUT_MS = 200;
+    private static final int OUTBOX_READ_TIMEOUT_MS = 10_000;
+
+    private HttpServer slowOms;
+    private String url;
+    private HttpRestService service;
+
+    @BeforeEach
+    void startSlowOms() throws Exception {
+        slowOms = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        slowOms.createContext("/services/call/finishedShipping", exchange -> {
+            try {
+                Thread.sleep(OMS_ANSWER_DELAY_MS);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+            byte[] body = "{\"Status\":\"Success\",\"Message\":\"OK\",\"Result\":[]}"
+                .getBytes(StandardCharsets.UTF_8);
+            exchange.getResponseHeaders().add("Content-Type", "application/json");
+            exchange.sendResponseHeaders(200, body.length);
+            try (OutputStream out = exchange.getResponseBody()) {
+                out.write(body);
+            } catch (java.io.IOException clientAlreadyGone) {
+                // The interactive call hangs up at its timeout; writing to it then is expected to fail.
+            }
+        });
+        // One thread per request, so the interactive call that the client abandons cannot hold up
+        // the outbox call behind it.
+        slowOms.setExecutor(java.util.concurrent.Executors.newCachedThreadPool());
+        slowOms.start();
+        url = "http://127.0.0.1:" + slowOms.getAddress().getPort() + "/services/call/finishedShipping";
+
+        // applyHeaders reads two sysprops; an unstubbed mock answers null, which it already tolerates.
+        service = new HttpRestService(mock(SyspropService.class),
+            INTERACTIVE_READ_TIMEOUT_MS, OUTBOX_READ_TIMEOUT_MS);
+    }
+
+    @AfterEach
+    void stopSlowOms() {
+        slowOms.stop(0);
+    }
+
+    @Test
+    @DisplayName("the outbox call waits for an OMS answer that takes longer than the interactive timeout")
+    void outboxCallOutlivesTheInteractiveTimeout() {
+        @SuppressWarnings("unchecked")
+        Map<String, String>[] result = new Map[1];
+        // A timed-out call throws rather than returning, so assert "no throw" with a message naming
+        // the cause; otherwise the red is a bare SocketTimeoutException that names nothing.
+        assertThatCode(() -> result[0] = service.postWithIdempotencyKey(url, "{\"bol_id\":\"B1\"}", "key-1"))
+            .as("postWithIdempotencyKey must use the outbox read timeout (%d ms), not the interactive "
+                + "one (%d ms): OMS answers after %d ms", OUTBOX_READ_TIMEOUT_MS,
+                INTERACTIVE_READ_TIMEOUT_MS, OMS_ANSWER_DELAY_MS)
+            .doesNotThrowAnyException();
+        assertThat(result[0].get("code")).isEqualTo("200");
+        assertThat(result[0].get("answer")).contains("\"Status\":\"Success\"");
+    }
+
+    @Test
+    @DisplayName("an interactive call still gives up at the interactive timeout")
+    void interactiveCallKeepsTheShortTimeout() {
+        assertThatThrownBy(() -> service.post(url, "{\"bol_id\":\"B1\"}"))
+            .as("post() serves operator-facing screens and must keep the short read timeout "
+                + "(%d ms); OMS answers after %d ms", INTERACTIVE_READ_TIMEOUT_MS, OMS_ANSWER_DELAY_MS)
+            .isInstanceOf(ResourceAccessException.class)
+            .hasRootCauseInstanceOf(SocketTimeoutException.class);
+    }
+
+    @Test
+    @DisplayName("a non-positive timeout is rejected at construction, not discovered as an infinite wait")
+    void rejectsNonPositiveTimeouts() {
+        SyspropService sysprops = mock(SyspropService.class);
+        // SimpleClientHttpRequestFactory reads 0 as "wait forever": a typo would pin the dispatcher.
+        assertThatThrownBy(() -> new HttpRestService(sysprops, 0, OUTBOX_READ_TIMEOUT_MS))
+            .isInstanceOf(IllegalArgumentException.class)
+            .hasMessageContaining("app.oms.http.read-timeout-ms");
+        assertThatThrownBy(() -> new HttpRestService(sysprops, INTERACTIVE_READ_TIMEOUT_MS, 0))
+            .isInstanceOf(IllegalArgumentException.class)
+            .hasMessageContaining("app.outbox.dispatcher.read-timeout-ms");
+    }
+}
